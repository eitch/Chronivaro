<?xml version="1.0" encoding="UTF-8"?>
<Roles>
    <Role name="StrolchAdmin">
        <Privilege name="li.strolch.privilege.policy.DefaultPrivilege" policy="DefaultPrivilege">
            <AllAllowed>true</AllAllowed>
        </Privilege>
        <Privilege name="li.strolch.search.StrolchSearch" policy="DefaultPrivilege">
            <AllAllowed>true</AllAllowed>
        </Privilege>
        <Privilege name="li.strolch.service.api.Service" policy="DefaultPrivilege">
            <AllAllowed>true</AllAllowed>
            <Allow>ch.atexxi.chronivaro.core.service.UpdateConfigurationService</Allow>
        </Privilege>
        <Privilege name="AddResource" policy="DefaultPrivilege">
            <AllAllowed>true</AllAllowed>
        </Privilege>
        <Privilege name="GetResource" policy="DefaultPrivilege">
            <AllAllowed>true</AllAllowed>
        </Privilege>
        <Privilege name="UpdateResource" policy="DefaultPrivilege">
            <AllAllowed>true</AllAllowed>
        </Privilege>
        <Privilege name="RemoveResource" policy="DefaultPrivilege">
            <AllAllowed>true</AllAllowed>
        </Privilege>
        <Privilege name="li.strolch.privilege.handler.SystemAction" policy="DefaultPrivilege">
            <AllAllowed>true</AllAllowed>
        </Privilege>
        <Privilege name="PrivilegeAction" policy="DefaultPrivilege">
            <AllAllowed>true</AllAllowed>
        </Privilege>
        <Privilege name="PrivilegeAddUser" policy="UserAccessPrivilege">
            <AllAllowed>true</AllAllowed>
        </Privilege>
        <Privilege name="PrivilegeGetUser" policy="UserAccessPrivilege">
            <AllAllowed>true</AllAllowed>
        </Privilege>
        <Privilege name="PrivilegeRemoveUser" policy="UserAccessPrivilege">
            <AllAllowed>true</AllAllowed>
        </Privilege>
        <Privilege name="PrivilegeModifyUser" policy="UserAccessPrivilege">
            <AllAllowed>true</AllAllowed>
        </Privilege>
    </Role>

    <Role name="Employee">
        <Privilege name="li.strolch.service.api.Service" policy="DefaultPrivilege">
            <Allow>ch.atexxi.chronivaro.core.service.DaySummaryService</Allow>
            <Allow>ch.atexxi.chronivaro.core.service.MonthSummaryService</Allow>
            <Allow>ch.atexxi.chronivaro.core.service.RequestAbsenceService</Allow>
            <Allow>ch.atexxi.chronivaro.core.service.UpdateAbsenceService</Allow>
            <Allow>ch.atexxi.chronivaro.core.service.CancelAbsenceService</Allow>
            <Allow>ch.atexxi.chronivaro.core.service.StartTimerService</Allow>
            <Allow>ch.atexxi.chronivaro.core.service.StopTimerService</Allow>
        </Privilege>
        <Privilege name="PrivilegeSetUserPassword" policy="DefaultPrivilege">
            <AllAllowed>true</AllAllowed>
        </Privilege>
    </Role>

    <Role name="Supervisor">
        <Privilege name="li.strolch.service.api.Service" policy="DefaultPrivilege">
            <Allow>ch.atexxi.chronivaro.core.service.ApproveAbsenceService</Allow>
            <Allow>ch.atexxi.chronivaro.core.service.RejectAbsenceService</Allow>
            <Allow>ch.atexxi.chronivaro.core.service.PresenceService</Allow>
        </Privilege>
    </Role>

    <Role name="HR">
        <Privilege name="li.strolch.service.api.Service" policy="DefaultPrivilege">
            <Allow>ch.atexxi.chronivaro.core.service.ApproveAbsenceService</Allow>
            <Allow>ch.atexxi.chronivaro.core.service.RejectAbsenceService</Allow>
            <Allow>ch.atexxi.chronivaro.core.service.PresenceService</Allow>
            <Allow>ch.atexxi.chronivaro.core.service.CreateEmployeeService</Allow>
            <Allow>ch.atexxi.chronivaro.core.service.UpdateEmployeeService</Allow>
        </Privilege>
    </Role>
</Roles>
